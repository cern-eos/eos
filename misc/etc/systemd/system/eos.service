# Deprecated: kept for one release for setups that still run 'systemctl start
# eos'. Use eos.target, which starts all the enabled eos@<name> instances.
[Unit]
Description=EOS All Services (deprecated, use eos.target)
Wants=eos.target
After=eos.target

[Service]
Type=oneshot
ExecStart=/bin/echo eos.service is deprecated and will be removed, \
use eos.target and \'systemctl status eos@*\' instead.

[Install]
WantedBy=multi-user.target
