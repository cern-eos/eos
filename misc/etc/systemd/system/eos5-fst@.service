[Unit]
Description=%I EOS5 FST service instance
# When systemd stops or restarts the app.service, the action is propagated to this unit
PartOf=eos5.service
# Start this unit after the app.service start
After=eos5-mgm.service
# Wait for network, DNS and mounted filesystems before start
Wants=network-online.target local-fs.target remote-fs.target
After=network.target network-online.target nss-lookup.target local-fs.target remote-fs.target

[Service]
# Pretend that the component is running
ExecStart=/usr/bin/eos daemon run fst %i
# Restart the service on non-zero exit code when terminated by a signal other than SIGHUP, SIGINT, SIGTERM or SIGPIPE
Restart=on-failure

[Install]
# This unit should start when app.service is starting
WantedBy=eos5.service
