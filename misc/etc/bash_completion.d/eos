#!/usr/bin/env bash

if [[ -n "${_EOS_BASH_COMPLETION_LOADED:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi
_EOS_BASH_COMPLETION_LOADED=1

# COMP_WORDS splits unquoted ':' and '=' and retains shell quoting. Read the
# logical argv directly, without evaluating expansions or executing user input.
# Results use the caller's local eos_words, word, and eos_replacement_prefix.
_eos_read_words()
{
  eos_words=()
  word=
  eos_replacement_prefix=

  if [[ -z "${COMP_LINE+x}" || -z "${COMP_POINT+x}" ]]; then
    eos_words=("${COMP_WORDS[@]:0:COMP_CWORD}")
    word="${COMP_WORDS[COMP_CWORD]}"
    eos_words+=("${word}")
    return 0
  fi

  local LC_ALL=C
  local line="${COMP_LINE:0:COMP_POINT}"
  local quote= char next
  local started=0 index
  local replacement_length=0

  for ((index = 0; index < ${#line}; ++index)); do
    char="${line:index:1}"
    if [[ ${quote} == "'" ]]; then
      if [[ ${char} == "'" ]]; then
        quote=
      else
        word+="${char}"
      fi
      continue
    fi

    if [[ ${quote} == '"' ]]; then
      case "${char}" in
        '"') quote= ;;
        '\')
          next="${line:index+1:1}"
          case "${next}" in
            '$'|'`'|'"'|'\') word+="${next}"; ((++index)) ;;
            $'\n') ((++index)) ;;
            *) word+="${char}" ;;
          esac
          ;;
        *) word+="${char}" ;;
      esac
      continue
    fi

    case "${char}" in
      "'"|'"') quote="${char}"; started=1 ;;
      '\')
        next="${line:index+1:1}"
        if [[ -n ${next} ]]; then
          [[ ${next} == $'\n' ]] || word+="${next}"
          ((++index))
        fi
        started=1
        ;;
      ' '|$'\t'|$'\n')
        if (( started )); then
          eos_words+=("${word}")
        fi
        word=
        started=0
        replacement_length=0
        ;;
      ';'|'|'|'&'|'('|')')
        # Completion concerns the current simple command in a command list.
        eos_words=()
        word=
        started=0
        replacement_length=0
        ;;
      '<'|'>'|'`') return 1 ;;
      '$')
        # Shell expansions are deliberately left to Bash, never evaluated here.
        [[ ${line:index+1:1} == '(' ]] && return 1
        word+="${char}"
        started=1
        ;;
      '#')
        (( started )) || return 1
        word+="${char}"
        ;;
      *)
        word+="${char}"
        started=1
        if [[ ${COMP_WORDBREAKS-} == *"${char}"* ]]; then
          replacement_length=${#word}
        fi
        ;;
    esac
  done

  eos_words+=("${word}")
  eos_replacement_prefix="${word:0:replacement_length}"
}

_eos()
{
  COMPREPLY=()
  compopt +o default +o bashdefault +o nospace 2>/dev/null

  local -a eos_words args
  local word eos_replacement_prefix reply
  _eos_read_words || return 0
  (( ${#eos_words[@]} )) || return 0
  args=("${eos_words[@]:1}")

  while IFS= read -r reply; do
    [[ -z ${reply} || ${reply} != "${word}"* ]] && continue
    # Bash replaces only the fragment after the last active word break.
    COMPREPLY+=("${reply:${#eos_replacement_prefix}}")
    if [[ ${reply} == *= || ${reply} == */ || ${reply} == *: ]]; then
      compopt -o nospace 2>/dev/null
    fi
  done < <(eos __complete "${args[@]}" 2>/dev/null)

  # Readline must quote spaces and metacharacters in returned paths/values.
  compopt -o filenames 2>/dev/null
  return 0
}

complete -o filenames -F _eos eos
