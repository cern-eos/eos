#compdef eos

local -a eos_args completions
local eos_word
integer eos_index

# Remove shell quoting without evaluating shell expansions or user input.
for (( eos_index = 2; eos_index < CURRENT; ++eos_index )); do
  eos_word="${(Q)words[eos_index]}"
  eos_args+=("${eos_word}")
done
# PREFIX excludes an opening quote even while the current quote is unfinished.
# Completed earlier words can be unquoted directly; the partial word cannot.
eos_args+=("${(Q)PREFIX}")

completions=("${(@f)$(eos __complete "${eos_args[@]}" 2>/dev/null)}")
completions=("${(@)completions:#}")
(( ${#completions[@]} )) || return 1

if (( ${#${(M)completions:#(*/|*=|*:)}} > 0 )); then
  compadd -f -S '' -- "${completions[@]}"
else
  compadd -f -- "${completions[@]}"
fi
