# Checks the WLCG Tape REST API of the MGM with WLCG tokens from a local token
# issuer. It runs on the MGM host, as root.

usage() {
  cat <<'EOF'
Usage: eos-tape-rest-token-test -t <directory> [-h <host>] [-p <https port>]
                                [-i <issuer URL>] [-k <key id>] [-u <tape user>]
                                [-a <audience>] [-c <client cert>]
                                [-K <client key>] [-S]

  -t  EOS directory under which the test creates, and then removes, its own tree
  -h  MGM host name, as in its certificate (default: hostname -f)
  -p  MGM HTTPS port (default: $EOS_HTTPS_PORT)
  -i  token issuer URL (default: https://<host>:4443)
  -k  key id of the issuer's signing key in /etc/xrootd (default: tapetest)
  -u  local user the issuer's tokens are mapped to (default: the default_user
      of that issuer in /etc/xrootd/scitokens.cfg)
  -a  token audience (default: https://wlcg.cern.ch/jwt/v1/any)
  -c  X.509 client certificate (default: $X509_USER_CERT, or
      /root/.globus/usercert.pem)
  -K  key of the X.509 client certificate (default: $X509_USER_KEY, or
      /root/.globus/userkey.pem)
  -S  serve the issuer from this test with eos-jwk-https, on the port of the
      issuer URL, with the host certificate. The signing key is created if it
      does not exist. Also set by EOS_TAPE_REST_TOKEN_SERVE_ISSUER=1.

Prerequisites on the MGM:
  - mgmofs.tapeenabled true, taperestapi.status=on and taperestapi.stage=on;
  - mgmofs.macaroonslib loads libXrdAccSciTokens.so, and "eos vid enable https";
  - /etc/xrootd/scitokens.cfg has an [Issuer] section with the issuer URL,
    base_path = /, map_subject = False and default_user = <tape user>, and its
    [Global] audience is the token audience;
  - without -S, the issuer serves the public key of
    "eos scitoken create-keys --keyid <key id>" (e.g. with eos-jwk-https);
  - the system trust store accepts the certificates of the issuer and the MGM;
  - the MGM maps the X.509 client certificate to the tape user, e.g. with a
    gridmap line, and accepts unix authentication from localhost.
A missing prerequisite skips the test, or fails it if EOS_TAPE_REST_TOKEN_REQUIRE=1.
If EOS token generation is off (space.token.generation=0), the test turns it on
while it runs and turns it off again at the end.
EOF
}

set -o pipefail

host=$(hostname -f)
port=${EOS_HTTPS_PORT:-}
prefix=""
issuer=""
keyid="tapetest"
user=""
audience="https://wlcg.cern.ch/jwt/v1/any"
serve=${EOS_TAPE_REST_TOKEN_SERVE_ISSUER:-0}
cert=${X509_USER_CERT:-/root/.globus/usercert.pem}
certkey=${X509_USER_KEY:-/root/.globus/userkey.pem}

while getopts "t:h:p:i:k:u:a:c:K:S" opt; do
  case $opt in
    t) prefix=${OPTARG%/} ;;
    h) host=$OPTARG ;;
    p) port=$OPTARG ;;
    i) issuer=${OPTARG%/} ;;
    k) keyid=$OPTARG ;;
    u) user=$OPTARG ;;
    a) audience=$OPTARG ;;
    c) cert=$OPTARG ;;
    K) certkey=$OPTARG ;;
    S) serve=1 ;;
    *) usage; exit 2 ;;
  esac
done

if [[ -z $prefix || -z $port ]]; then
  usage
  exit 2
fi

issuer=${issuer:-https://$host:4443}
mgm="https://$host:$port"
rooturl="root://localhost"
jwk="/etc/xrootd/$keyid-sci.jwk"

skip_or_fail() {
  if [[ ${EOS_TAPE_REST_TOKEN_REQUIRE:-0} == 1 ]]; then
    echo "FAIL: missing prerequisite: $1"
    exit 1
  fi

  echo "SKIP: $1"
  exit 0
}

for cmd in eos curl jq xrdcp runuser; do
  if ! command -v "$cmd" > /dev/null; then
    echo "FAIL: $cmd not found"
    exit 1
  fi
done

if [[ $serve == 1 ]] && ! command -v eos-jwk-https > /dev/null; then
  echo "FAIL: eos-jwk-https (package eos-scitokenapi) not found, needed by -S"
  exit 1
fi

# --- Prerequisites on the MGM ------------------------------------------------
[[ $(eos -b "$rooturl" ns stat -m) =~ (^|[[:space:]])ns\.tapeenabled=true([[:space:]]|$) ]] ||
  skip_or_fail "the MGM is not tape-enabled"

space=$(eos -b "$rooturl" space status default -m)
[[ $space =~ (^|[[:space:]])taperestapi\.status=on([[:space:]]|$) &&
   $space =~ (^|[[:space:]])taperestapi\.stage=on([[:space:]]|$) ]] ||
  skip_or_fail "taperestapi.status or taperestapi.stage is not on in the default space"

curl -fsS "$mgm/.well-known/wlcg-tape-rest-api" 2>&1 |
  jq -e '.endpoints | any(.version == "v1")' > /dev/null ||
  skip_or_fail "$mgm does not serve the v1 tape REST API (or its certificate is not trusted)"

if [[ -z $user ]]; then
  user=$(awk -v iss="$issuer" '
    function val(s) { sub(/^[^=]*=[[:space:]]*/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    /^[[:space:]]*\[/ {
      if (found && du != "") { print du; printed = 1; exit }
      found = 0; du = ""; next
    }
    /^[[:space:]]*issuer[[:space:]]*=/ { v = val($0); sub(/\/$/, "", v); if (v == iss) found = 1 }
    /^[[:space:]]*default_user[[:space:]]*=/ { du = val($0) }
    END { if (!printed && found && du != "") print du }' /etc/xrootd/scitokens.cfg 2> /dev/null)
fi

[[ -n $user ]] ||
  skip_or_fail "no [Issuer] for $issuer with a default_user in /etc/xrootd/scitokens.cfg"
getent passwd "$user" > /dev/null ||
  skip_or_fail "tape user $user does not exist"
[[ -r $cert && -r $certkey ]] ||
  skip_or_fail "no X.509 client certificate $cert with its key $certkey"
! grep -q ENCRYPTED "$certkey" ||
  skip_or_fail "the key $certkey has a pass phrase; the test needs a key without one"

# --- Fixture -----------------------------------------------------------------
work=$(mktemp -d) || exit 1
dir="$prefix/tape-rest-token-$(cat /proc/sys/kernel/random/uuid)"
in="$dir/in/f"
out="$dir/out/f"
xt=""
created=0
requests=()
failures=0
code=""
issuer_pid=""
generation=""
TOK_STAGE=""

# api <method> <path below /api/v1/> <token or ""> [JSON body [curl options...]]
# Sets $code and leaves the response body in $work/body, and curl's error in
# $work/curl.err.
api() {
  local args=(-sS -o "$work/body" -w '%{http_code}' -X "$1")

  : > "$work/body"

  if [[ -n $3 ]]; then
    args+=(-H "Authorization: Bearer $3")
  fi

  if [[ -n ${4:-} ]]; then
    args+=(-H "Content-Type: application/json" --data-binary "$4")
  fi

  code=$(curl "${args[@]}" "${@:5}" "$mgm/api/v1/$2" 2> "$work/curl.err") || code=000
}

cleanup() {
  local rc=$? id

  trap - EXIT

  for id in "${requests[@]}"; do
    api DELETE "stage/$id" "$TOK_STAGE"

    if [[ $code != 200 && $code != 404 ]]; then
      echo "FAIL: cleanup of stage request $id: HTTP $code"
      rc=1
    fi
  done

  if (( created )) && ! eos -b "$rooturl" rm -r "$dir" > /dev/null; then
    echo "FAIL: cleanup of $dir"
    rc=1
  fi

  if [[ -n $generation ]] &&
     ! eos -b "$rooturl" space config default "space.token.generation=$generation" > /dev/null; then
    echo "FAIL: cleanup: cannot set space.token.generation back to $generation"
    rc=1
  fi

  if [[ -n $issuer_pid ]] && ! stop_issuer; then
    rc=1
  fi

  rm -rf "$work" ${xt:+"$xt"}
  exit $rc
}

trap cleanup EXIT

# Prints what eos-jwk-https wrote to stderr: its errors and the requests it got.
issuer_log() {
  if [[ -s $work/issuer.err ]]; then
    echo "eos-jwk-https log:"
    sed 's/^/  /' "$work/issuer.err"
  fi
}

# Starts eos-jwk-https in the background and waits for its "ready" line.
start_issuer() {
  local i line=""

  if [[ ! -e /etc/xrootd/$keyid-key.pem ]]; then
    eos scitoken create-keys --keyid "$keyid" > /dev/null || return 1
  fi

  if [[ ! -r $jwk ]]; then
    echo "FAIL: $jwk is missing; remove /etc/xrootd/$keyid-*.pem to create a new key"
    return 1
  fi

  eos-jwk-https --issuer "$issuer" --jwk "$jwk" > "$work/issuer.out" 2> "$work/issuer.err" &
  issuer_pid=$!

  for i in $(seq 1 50); do
    IFS= read -r line < "$work/issuer.out"

    if [[ $line == "ready "* ]]; then
      return 0
    fi

    if ! kill -0 "$issuer_pid" 2> /dev/null; then
      wait "$issuer_pid"
      issuer_pid=""
      break
    fi

    sleep 0.2
  done

  issuer_log
  echo "FAIL: eos-jwk-https did not print its ready line for $issuer"
  return 1
}

# Stops eos-jwk-https with SIGTERM, which makes it exit with 0.
stop_issuer() {
  local i rc

  kill -TERM "$issuer_pid" 2> /dev/null

  for i in $(seq 1 50); do
    kill -0 "$issuer_pid" 2> /dev/null || break
    sleep 0.2
  done

  if kill -0 "$issuer_pid" 2> /dev/null; then
    echo "FAIL: eos-jwk-https still runs 10 s after SIGTERM"
    kill -KILL "$issuer_pid" 2> /dev/null
  fi

  wait "$issuer_pid"
  rc=$?
  issuer_pid=""

  if [[ $rc != 0 ]]; then
    echo "FAIL: eos-jwk-https exited with $rc"
    return 1
  fi
}

if [[ $serve == 1 ]]; then
  start_issuer || exit 1
fi

[[ -r /etc/xrootd/$keyid-key.pem ]] ||
  skip_or_fail "no signing key /etc/xrootd/$keyid-key.pem"

curl -fsS "$issuer/.well-known/openid-configuration" 2>&1 |
  jq -e '.jwks_uri | type == "string"' > /dev/null ||
  skip_or_fail "issuer $issuer is not reachable (or its certificate is not trusted)"

setup() {
  local d w

  eos -b "$rooturl" mkdir -p "$dir" || return 1
  created=1

  # Only <tape user> may read and prepare, so a request mapped to nobody is
  # refused. EOS checks the directory's permissions when a file is read, not the
  # file's own mode.
  for d in "$dir/in" "$dir/out"; do
    eos -b "$rooturl" mkdir "$d" &&
      eos -b "$rooturl" chown "$user" "$d" &&
      eos -b "$rooturl" attr set "sys.acl=u:$user:p" "$d" || return 1

    # No-op workflows: without CTA, stage, release and cancel only run the
    # MGM checks.
    for w in prepare evict_prepare abort_prepare; do
      eos -b "$rooturl" attr set "sys.workflow.sync::$w.default=noop" "$d" || return 1
    done

    # Each file holds its own path, so that a copy shows which file it is.
    # Restrict the directory last: once it is 700, the xrdcp above cannot
    # write into it.
    printf '%s\n' "$d/f" > "$work/payload" &&
      xrdcp -s -f "$work/payload" "$rooturl/$d/f" &&
      eos -b "$rooturl" chown "$user" "$d/f" &&
      eos -b "$rooturl" chmod 600 "$d/f" &&
      eos -b "$rooturl" chmod 700 "$d" || return 1
  done
}

# mint <scope> [subject]
mint() {
  eos scitoken create --issuer "$issuer" --keyid "$keyid" --profile wlcg \
    --claim "sub=${2:-tape-rest-token-test}" --claim "aud=$audience" \
    --claim "scope=$1" --expires $(( $(date +%s) + 3600 ))
}

is_jwt() {
  [[ $1 =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]]
}

pass() {
  echo "PASS: $1"
}

fail() {
  echo "FAIL: $1"

  if [[ -s $work/body ]]; then
    echo "  body: $(head -c 2000 "$work/body")"
  fi

  failures=$((failures + 1))
}

# expect <case> <HTTP code> [jq filter [jq options...]]
expect() {
  local name=$1 want=$2 filter=${3:-}

  if [[ $code == 000 ]]; then
    fail "$name: no HTTP answer, expected $want: $(tail -n 1 "$work/curl.err" 2> /dev/null)"
    return 1
  fi

  if [[ $code != "$want" ]]; then
    fail "$name: HTTP $code, expected $want"
    return 1
  fi

  if [[ -n $filter ]] && ! jq -e "${@:4}" "$filter" "$work/body" > /dev/null 2>&1; then
    fail "$name: unexpected response body"
    return 1
  fi

  pass "$name"
}

echo "MGM $mgm, issuer $issuer (key $keyid$([[ $serve == 1 ]] && echo ", served by the test")), tape user $user, directory $dir"

if ! setup; then
  echo "FAIL: setup of $dir"
  exit 1
fi

TOK_STAGE=$(mint "storage.stage:$dir/in")
TOK_READ=$(mint "storage.read:$dir/in")
TOK_STAGE_OUT=$(mint "storage.stage:$dir/out")
TOK_POLL=$(mint "storage.poll:$dir/in")

if ! is_jwt "$TOK_STAGE" || ! is_jwt "$TOK_READ" || ! is_jwt "$TOK_STAGE_OUT" ||
   ! is_jwt "$TOK_POLL"; then
  echo "FAIL: eos scitoken create did not return a token"
  exit 1
fi

# The claims of TOK_STAGE with the signature of TOK_READ: a WLCG token that
# does not validate.
TOK_INVALID="${TOK_STAGE%.*}.${TOK_READ##*.}"

# --- Cases -------------------------------------------------------------------
: > "$work/body"
code=$(curl -s -o "$work/body" -w '%{http_code}' "$mgm/.well-known/wlcg-tape-rest-api") || code=000
expect "well-known, no credentials" 200 \
  '.endpoints | any(.version == "v1" and (.uri | endswith("/api/v1")))'

# --- Requests without credentials --------------------------------------------
# A tape REST request without credentials, or with a bearer token that is not a
# JWT, maps to nobody: it gets 401 with a bearer challenge and changes nothing.

# unauthenticated <method> <path below /api/v1/> <token or ""> [JSON body]
# Like api, without a client certificate; keeps the response headers.
unauthenticated() {
  : > "$work/headers"
  api "$1" "$2" "$3" "${4:-}" -D "$work/headers"
}

# expect_401 <case>
expect_401() {
  if [[ $code == 401 ]] && ! grep -qiE '^www-authenticate:[[:space:]]*bearer' "$work/headers"; then
    fail "$1: HTTP 401 without a WWW-Authenticate: Bearer header"
    return 1
  fi

  expect "$1" 401
}

instance=$(eos -b "$rooturl" version 2> /dev/null | sed -n 's/^EOS_INSTANCE=//p')
stagedir="/eos/${instance#eos}/proc/tape-rest-api/bulkrequests/stage"

# Number of stage requests that the MGM keeps in its proc directory; fails if
# the directory cannot be listed
stage_requests() {
  local listing

  listing=$(eos -b "$rooturl" ls "$stagedir") || return 1
  grep -c . <<< "$listing" || true
}

if [[ -z $instance ]]; then
  fail "stage without credentials: no EOS_INSTANCE in the output of eos version"
elif ! before=$(stage_requests); then
  fail "stage without credentials: cannot list $stagedir"
else
  unauthenticated POST stage/ "" "{\"files\":[{\"path\":\"$in\"}]}"
  expect_401 "stage, no credentials"

  unauthenticated POST stage/ "not-a-jwt" "{\"files\":[{\"path\":\"$in\"}]}"
  expect_401 "stage, bearer token that is not a JWT"

  if ! after=$(stage_requests); then
    fail "stage without credentials: cannot list $stagedir after the requests"
  elif [[ $after != "$before" ]]; then
    fail "stage without credentials: $stagedir went from $before to $after stage requests"
  else
    pass "stage without credentials: no new stage request in $stagedir"
  fi
fi

unauthenticated POST archiveinfo/ "" "{\"paths\":[\"$in\"]}"
expect_401 "archiveinfo, no credentials"

api POST stage/ "$TOK_STAGE" "{\"files\":[{\"path\":\"$in\"}]}"

if expect "stage, in-scope token, for the cases without credentials" 201 \
     '.requestId | type == "string" and length > 0'; then
  id=$(jq -r .requestId "$work/body")
  requests+=("$id")

  unauthenticated GET "stage/$id" ""
  expect_401 "stage status, no credentials"

  unauthenticated POST "stage/$id/cancel" "" "{\"paths\":[\"$in\"]}"
  expect_401 "cancel, no credentials"

  unauthenticated POST "release/$id" "" "{\"paths\":[\"$in\"]}"
  expect_401 "release, no credentials"

  unauthenticated DELETE "stage/$id" ""
  expect_401 "delete, no credentials"

  api GET "stage/$id" "$TOK_STAGE"
  expect "stage status after a delete without credentials" 200 '.id == $id' --arg id "$id"
else
  fail "stage status, cancel, release and delete without credentials not run: no stage request"
fi

api POST archiveinfo/ "$TOK_STAGE" "{\"paths\":[\"$in\"]}"
expect "archiveinfo, in-scope token" 200 \
  'length == 1 and .[0].path == $p and .[0].locality == "DISK" and (.[0].error // "") == ""' \
  --arg p "$in"

api POST archiveinfo/ "$TOK_POLL" "{\"paths\":[\"$in\"]}"
expect "archiveinfo, poll token" 200 \
  'length == 1 and .[0].path == $p and .[0].locality == "DISK" and (.[0].error // "") == ""' \
  --arg p "$in"

api POST stage/ "$TOK_STAGE" "{\"files\":[{\"path\":\"$in\"}]}"

if expect "stage, in-scope token" 201 '.requestId | type == "string" and length > 0'; then
  id=$(jq -r .requestId "$work/body")
  requests+=("$id")

  api GET "stage/$id" "$TOK_STAGE"
  expect "stage status, same token" 200 \
    '.id == $id and (.files | length == 1) and .files[0].path == $p and (.files[0].error // "") == ""' \
    --arg id "$id" --arg p "$in"

  api GET "stage/$id" "$TOK_POLL"
  expect "stage status, poll token" 200 \
    '.id == $id and (.files | length == 1) and .files[0].path == $p and (.files[0].error // "") == ""' \
    --arg id "$id" --arg p "$in"

  api POST "release/$id" "$TOK_STAGE" "{\"paths\":[\"$in\"]}"
  expect "release, same token" 200

  api POST "stage/$id/cancel" "$TOK_STAGE" "{\"paths\":[\"$in\"]}"
  expect "cancel, same token" 200

  api DELETE "stage/$id" "$TOK_STAGE"
  expect "delete, same token" 200

  api GET "stage/$id" "$TOK_STAGE"
  expect "stage status after delete" 404
else
  fail "stage status, release, cancel and delete not run: no stage request"
fi

# --- Tokens that authorize none of the files ---------------------------------
# A request whose token authorizes none of its files gets 403. A stage, cancel,
# release or delete creates no stage request and leaves the existing ones as
# they are; archiveinfo and the stage status tell nothing about the files. A
# token that authorizes the files keeps its request when the files fail for
# another reason, e.g. because they do not exist.

# refused_changes <case> <token> <request id>
refused_changes() {
  api POST stage/ "$2" "{\"files\":[{\"path\":\"$in\"}]}"

  if [[ $code == 201 ]]; then
    requests+=("$(jq -r .requestId "$work/body")")
  fi

  expect "stage, $1" 403

  api POST "stage/$3/cancel" "$2" "{\"paths\":[\"$in\"]}"
  expect "cancel, $1" 403

  api POST "release/$3" "$2" "{\"paths\":[\"$in\"]}"
  expect "release, $1" 403

  api DELETE "stage/$3" "$2"
  expect "delete, $1" 403
}

# refused_queries <case> <token> <request id>
refused_queries() {
  api POST archiveinfo/ "$2" "{\"paths\":[\"$in\"]}"
  expect "archiveinfo, $1" 403

  api GET "stage/$3" "$2"
  expect "stage status, $1" 403
}

api POST stage/ "$TOK_STAGE" "{\"files\":[{\"path\":\"$in\"}]}"

if expect "stage, in-scope token, for the tokens that authorize no file" 201 \
     '.requestId | type == "string" and length > 0'; then
  id=$(jq -r .requestId "$work/body")
  requests+=("$id")

  if ! before=$(stage_requests); then
    fail "tokens that authorize no file: cannot list $stagedir"
  else
    refused_changes "token without the stage permission" "$TOK_READ" "$id"
    refused_changes "stage token for another directory" "$TOK_STAGE_OUT" "$id"
    refused_queries "token without the stage permission" "$TOK_READ" "$id"
    refused_queries "stage token for another directory" "$TOK_STAGE_OUT" "$id"

    if ! after=$(stage_requests); then
      fail "tokens that authorize no file: cannot list $stagedir after the requests"
    elif [[ $after != "$before" ]]; then
      fail "tokens that authorize no file: $stagedir went from $before to $after stage requests"
    else
      pass "tokens that authorize no file: no new stage request in $stagedir"
    fi
  fi

  api GET "stage/$id" "$TOK_STAGE"
  expect "stage status after the changes with tokens that authorize no file" 200 \
    '.id == $id and (.files | length == 1) and .files[0].path == $p and (.files[0].error // "") == ""' \
    --arg id "$id" --arg p "$in"
else
  fail "changes with tokens that authorize no file not run: no stage request"
fi

missing="$dir/in/missing"

if ! before=$(stage_requests); then
  fail "stage, in-scope token, missing file: cannot list $stagedir"
else
  api POST stage/ "$TOK_STAGE" "{\"files\":[{\"path\":\"$missing\"}]}"

  if expect "stage, in-scope token, missing file" 201 \
       '.requestId | type == "string" and length > 0'; then
    id=$(jq -r .requestId "$work/body")
    requests+=("$id")

    if ! after=$(stage_requests); then
      fail "stage, in-scope token, missing file: cannot list $stagedir after the request"
    elif (( after != before + 1 )); then
      fail "stage, in-scope token, missing file: $stagedir went from $before to $after stage requests, expected one more"
    else
      pass "stage, in-scope token, missing file: one new stage request in $stagedir"
    fi

    api GET "stage/$id" "$TOK_STAGE"
    expect "stage status, in-scope token, missing file" 200 \
      '.id == $id and (.files | length == 1) and .files[0].path == $p and (.files[0].error | type == "string" and length > 0)' \
      --arg id "$id" --arg p "$missing"
  fi

  # A delete cancels every file of its request, and fails while one of them
  # does not exist: create the file, so that the cleanup can delete the request
  if ! eos -b "$rooturl" touch "$missing" > /dev/null; then
    fail "stage, in-scope token, missing file: cannot create $missing for the cleanup"
  fi
fi

: > "$work/body"
code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOK_READ" "$mgm$in") ||
  code=000
expect "GET of an in-scope file, read token" 307

# --- Paths with "." or ".." components ---------------------------------------
# Every route that takes paths refuses a path with a "." or ".." component.
# Names that only contain dots, such as "a..b", stay valid.
dotdot="$dir/in/../out/f"
dot="$dir/in/./f"
invalid_path='.status == 400 and .title == "JSON Validation error"'

api POST archiveinfo/ "$TOK_STAGE" "{\"paths\":[\"$dotdot\"]}"
expect "archiveinfo, path with a .. component" 400 "$invalid_path"

api POST archiveinfo/ "$TOK_STAGE" "{\"paths\":[\"$dot\"]}"
expect "archiveinfo, path with a . component" 400 "$invalid_path"

# The prepare code would only see the part of a path before a NUL character.
# The detail shows the path up to the NUL, then the reason.
api POST archiveinfo/ "$TOK_STAGE" "{\"paths\":[\"$dir/in/..\\u0000\"]}"
expect "archiveinfo, path with a NUL character" 400 \
  "$invalid_path"' and .detail == "Invalid path \"\($p)\": The path must not contain a NUL character"' \
  --arg p "$dir/in/.."

api POST archiveinfo/ "$TOK_STAGE" "{\"paths\":[\"$dir/in/a..b\"]}"
expect "archiveinfo, file name with two dots" 200 \
  'length == 1 and .[0].path == $p and (.[0].error | type == "string" and length > 0)' \
  --arg p "$dir/in/a..b"

api POST stage/ "$TOK_STAGE" "{\"files\":[{\"path\":\"$dotdot\"}]}"

if [[ $code == 201 ]]; then
  requests+=("$(jq -r .requestId "$work/body")")
fi

expect "stage, path with a .. component" 400 "$invalid_path"

# The paths are checked before the request id
api POST release/no-such-request "$TOK_STAGE" "{\"paths\":[\"$dotdot\"]}"
expect "release, path with a .. component" 400 "$invalid_path"

api POST stage/no-such-request/cancel "$TOK_STAGE" "{\"paths\":[\"$dotdot\"]}"
expect "cancel, path with a .. component" 400 "$invalid_path"

# --- Requests on one connection ----------------------------------------------
# The MGM keeps the client's identity for the whole connection. Each request
# must map only with its own credentials, never with the user that a token gave
# to an earlier request on the same connection. The out file is outside the
# scope of the tokens, but the tape user may read and prepare it.

# Whether curl sent its second request on the connection of the first one
reused() {
  grep -qE 'Re-?using existing' "$work/curl.err"
}

name="GET of the out file without a token, after a token GET on the same connection"
: > "$work/body"
mapfile -t codes < <(curl -sv -o /dev/null -w '%{http_code}\n' \
  -H "Authorization: Bearer $TOK_READ" "$mgm$in" \
  --next -o /dev/null -w '%{http_code}\n' "$mgm$out" 2> "$work/curl.err")

if ! reused; then
  fail "$name: curl did not reuse the connection"
elif [[ ${codes[0]:-} != 307 ]]; then
  fail "$name: the token GET got HTTP ${codes[0]:-none}, expected 307"
elif [[ ${codes[1]:-} != 403 ]]; then
  fail "$name: HTTP ${codes[1]:-none}, expected 403"
else
  pass "$name"
fi

name="archiveinfo of the out file with an invalid token, after a valid token on the same connection"
: > "$work/body"
mapfile -t codes < <(curl -sv -o /dev/null -w '%{http_code}\n' -X POST \
  -H "Authorization: Bearer $TOK_STAGE" -H "Content-Type: application/json" \
  --data-binary "{\"paths\":[\"$in\"]}" "$mgm/api/v1/archiveinfo/" \
  --next -o "$work/body" -w '%{http_code}\n' -X POST \
  -H "Authorization: Bearer $TOK_INVALID" -H "Content-Type: application/json" \
  --data-binary "{\"paths\":[\"$out\"]}" "$mgm/api/v1/archiveinfo/" 2> "$work/curl.err")

if ! reused; then
  fail "$name: curl did not reuse the connection"
elif [[ ${codes[0]:-} != 200 ]]; then
  fail "$name: the valid token got HTTP ${codes[0]:-none}, expected 200"
else
  # The second token does not get the user of the first one: it authorizes no file
  code=${codes[1]:-000}
  expect "$name" 403
fi

# xrdcp opens its sources one after the other, on one connection to the MGM.
name="xroot open of the out file with an invalid token, after a valid token on the same connection"
: > "$work/body"

if ! xt=$(mktemp -d) || ! chown nobody "$xt"; then
  fail "$name: cannot create a directory for nobody"
else
  # nobody cannot read root's X.509 credentials
  runuser -u nobody -- env -u X509_USER_CERT -u X509_USER_KEY -u X509_USER_PROXY \
    XrdSecPROTOCOL=unix "$(command -v xrdcp)" -s -f \
    "$rooturl/$in?authz=Bearer%20$TOK_READ" \
    "$rooturl/$out?authz=Bearer%20$TOK_INVALID" "$xt/" > "$work/body" 2>&1
  rc=$?

  if [[ $rc == 0 ]]; then
    fail "$name: xrdcp copied both files"
  elif [[ $(cat "$xt/f" 2> /dev/null) != "$in" ]]; then
    # e.g. "eos vid add gateway localhost unix" maps unix clients by their own
    # name after the token mapping
    fail "$name: xrdcp failed with $rc, and the in file was not copied: the valid token did not map to $user over xroot (a gateway or tident rule for unix on localhost?)"
  else
    pass "$name"
  fi
fi

# --- A client certificate with a token ---------------------------------------
# With a WLCG token, only the token gives the identity: the token's user, or
# nobody, never the client's X.509 identity. An EOS token without an owner keeps
# the identity of the client that presents it.
api POST archiveinfo/ "" "{\"paths\":[\"$in\"]}" --cert "$cert" --key "$certkey"

if ! expect "archiveinfo, client certificate" 200 \
       'length == 1 and .[0].path == $p and .[0].locality == "DISK" and (.[0].error // "") == ""' \
       --arg p "$in"; then
  echo "  the MGM must map the X.509 identity of $cert to $user"
fi

# With a token, the X.509 identity does not count: this token authorizes no file
api POST archiveinfo/ "$TOK_INVALID" "{\"paths\":[\"$in\"]}" --cert "$cert" --key "$certkey"
expect "archiveinfo, client certificate and an invalid token" 403

name="whoami, client certificate and an EOS token without an owner in the header"
space=$(eos -b "$rooturl" space status default -m)

if [[ $space =~ (^|[[:space:]])token\.generation=([0-9]+)([[:space:]]|$) ]] &&
   [[ ${BASH_REMATCH[2]} != 0 ]]; then
  generation_on=1
elif eos -b "$rooturl" space config default space.token.generation=1 > /dev/null; then
  generation=0
  generation_on=1
else
  generation_on=0
fi

if (( ! generation_on )); then
  fail "$name: cannot turn on EOS token generation"
else
  # Issued by root, so the token has no owner
  eostok=$(eos -b "$rooturl" token --path "$dir/" --permission rx --tree \
             --expires $(( $(date +%s) + 3600 )))

  if [[ $eostok != zteos64:* ]] && ! is_jwt "$eostok"; then
    fail "$name: eos token did not return a token"
  else
    tape_uid=$(id -u "$user")
    : > "$work/body"
    code=$(curl -sS -o "$work/body" -w '%{http_code}' --cert "$cert" --key "$certkey" \
             -H "Authorization: Bearer $eostok" \
             "$mgm/proc/user/?mgm.cmd=whoami&mgm.option=m&mgm.format=fuse" \
             2> "$work/curl.err") || code=000

    if [[ $code != 200 ]]; then
      fail "$name: HTTP $code, expected 200: $(tail -n 1 "$work/curl.err" 2> /dev/null)"
    elif ! grep -qE "(^|[[:space:]])uid=$tape_uid([[:space:]]|$)" "$work/body"; then
      fail "$name: not mapped to the certificate's user $user (uid $tape_uid)"
    else
      pass "$name"
    fi

    # The tape REST API takes a token only in the Authorization header (see "A
    # token in the URL" below), an EOS token too
    api POST "archiveinfo/?authz=$(jq -rn --arg t "$eostok" '$t | @uri')" "" \
      "{\"paths\":[\"$in\"]}" --cert "$cert" --key "$certkey"
    expect "archiveinfo, client certificate and an EOS token without an owner in the URL" 400 \
      '.status == 400 and .title == "Bad request"'
  fi
fi

# --- A token in the URL ------------------------------------------------------
# The tape REST API takes a token only in the Authorization header. A request
# with a token in its URL gets 400 and changes nothing, whatever identity the
# token or a client certificate gives. The well-known document stays reachable
# whatever the credentials.
token_in_url='.status == 400 and .title == "Bad request"'

if [[ -z $instance ]]; then
  fail "stage, in-scope token in the URL: no EOS_INSTANCE in the output of eos version"
elif ! before=$(stage_requests); then
  fail "stage, in-scope token in the URL: cannot list $stagedir"
else
  api POST "stage/?authz=$TOK_STAGE" "" "{\"files\":[{\"path\":\"$in\"}]}"

  if [[ $code == 201 ]]; then
    requests+=("$(jq -r .requestId "$work/body")")
  fi

  expect "stage, in-scope token in the URL" 400 "$token_in_url"

  if ! after=$(stage_requests); then
    fail "stage, in-scope token in the URL: cannot list $stagedir after the request"
  elif [[ $after != "$before" ]]; then
    fail "stage, in-scope token in the URL: $stagedir went from $before to $after stage requests"
  else
    pass "stage, in-scope token in the URL: no new stage request in $stagedir"
  fi
fi

api POST "archiveinfo/?authz=Bearer%20$TOK_STAGE" "" "{\"paths\":[\"$in\"]}"
expect "archiveinfo, in-scope token in the URL with Bearer%20" 400 "$token_in_url"

api POST "archiveinfo/?authz=$TOK_STAGE" "" "{\"paths\":[\"$in\"]}" \
  --cert "$cert" --key "$certkey"
expect "archiveinfo, client certificate and an in-scope token in the URL" 400 "$token_in_url"

well_known='.endpoints | any(.version == "v1" and (.uri | endswith("/api/v1")))'

: > "$work/body"
code=$(curl -sS -o "$work/body" -w '%{http_code}' \
         "$mgm/.well-known/wlcg-tape-rest-api?authz=$TOK_STAGE" 2> "$work/curl.err") || code=000
expect "well-known, token in the URL" 200 "$well_known"

: > "$work/body"
code=$(curl -sS -o "$work/body" -w '%{http_code}' -H "Authorization: Bearer $TOK_STAGE" \
         "$mgm/.well-known/wlcg-tape-rest-api" 2> "$work/curl.err") || code=000
expect "well-known, token in the Authorization header" 200 "$well_known"

: > "$work/body"
code=$(curl -sS -o "$work/body" -w '%{http_code}' --cert "$cert" --key "$certkey" \
         "$mgm/.well-known/wlcg-tape-rest-api" 2> "$work/curl.err") || code=000
expect "well-known, client certificate" 200 "$well_known"

if (( failures )); then
  issuer_log
  echo "FAIL: $failures case(s) failed"
  exit 1
fi

echo "PASS: all cases"
