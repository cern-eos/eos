# bats file_tags=fuse
load ../instance

# The tests use the FUSE mount at /eos, if there is one. krb5 and x509 are off.
export X509_USER_PROXY=/tmp/invalid
export KRB5CCNAME=/tmp/invalid

@test "the FUSE mount at /eos honours the permissions" {
  [ -e "/eos/$EOS_TEST_INSTANCE" ] || skip "no FUSE mount at /eos"

  runtest "### Mkdir     " unix SUCCESS "" eos mkdir "-p" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 755 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE cp   " unix ERROR "" shell cp "$TESTSYSFILE1K" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file.1k"
  runtest "### FUSE touch" unix SUCCESS "" shell stat "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/touch"
  runtest "### FUSE cat  " unix SUCCESS "" shell stat "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/touch"
  runtest "### FUSE rm   " unix SUCCESS "" shell stat "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/touch"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE cp   " unix SUCCESS "" shell cp "$TESTSYSFILE1K" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file.1k"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 755 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE mkdr " unix ERROR "" shell mkdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.forbidden"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE mkdr " unix SUCCESS "" shell mkdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed"
  runtest "### FUSE mkdr " unix SUCCESS "" shell mkdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed2"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 755 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE mkdr " unix ERROR "" shell rmdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE mkdr " unix SUCCESS "" shell rmdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/"
  runtest "### FUSE chmd " unix ERROR "" shell chmod 755 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/"
  runtest "### Chown     " unix SUCCESS "" eos chown 2:2 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE chmd " unix SUCCESS "" shell chmod 555 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE mv   " unix ERROR "" shell mv "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file.1k" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file.1k.forbidden"
  runtest "### FUSE chmd " unix SUCCESS "" shell chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse"
  runtest "### FUSE mv   " unix SUCCESS "" shell mv "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file.1k" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file.1k.forbidden"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 555 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed2"
  runtest "### FUSE mv   " unix ERROR "" shell mv "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file.1k.forbidden" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed2"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed2"
  runtest "### FUSE mv   " unix SUCCESS "" shell mv "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file.1k.forbidden" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed2"
  runtest "### FUSE mv   " unix SUCCESS "" shell mv "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed2" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 555 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 555 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/"
  runtest "### rm        " unix ERROR "" shell rm "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed"
  runtest "### rm        " unix ERROR "" shell rm "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed/file.1k.forbidden"
  runtest "### rmdir     " unix ERROR "" shell rmdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed/"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed"
  runtest "### rmdir     " unix ERROR "" shell rmdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed/"
  runtest "### rm        " unix SUCCESS "" shell rm "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed/file.1k.forbidden"
  runtest "### rmdir     " unix SUCCESS "" shell rmdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir.allowed/"
  runtest "### touch sp  " unix SUCCESS "" shell touch "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file\ 1"
  runtest "### mv sp     " unix SUCCESS "" shell mv "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file\ 1" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file\ 2"
  runtest "### stat sp   " unix ERROR "" shell stat "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file\ 1"
  runtest "### stat sp   " unix SUCCESS "" shell stat "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file\ 2"
  runtest "### rm sp     " unix SUCCESS "" shell rm "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/file\ 2"
  runtest "### FUSE mkdr " unix SUCCESS "" eos mkdir -p "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/"
  runtest "### Chmod     " unix SUCCESS "" eos chmod 777 "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/"
  runtest "### FUSE mkdr " unix SUCCESS "" mkdir -p "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir1/"
  runtest "### FUSE lnk  " unix SUCCESS "" shell ln -s "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir1" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/link1"
  runtest "### FUSE lnk  " unix SUCCESS "" shell ln -s "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir1" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/link1"
  runtest "### FUSE lnk  " unix ERROR "" shell ln -s "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir1" "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/link1"
  runtest "### FUSE mkdr " unix SUCCESS "" shell mkdir "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/link1/dir2"
  runtest "### FUSE stat " unix SUCCESS "" shell stat "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/link1/dir2"
  runtest "### FUSE stat " unix SUCCESS "" shell stat "/eos/$EOS_TEST_INSTANCE/test/instancetest/fuse/dir1/dir2"
}
