#!/bin/bash
# ------------------------------------------------------------------------------
# Helpers of eos-contention-test: the test framework, the set up and the end
# checks. The test sources this file after its settings.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Test framework
# ------------------------------------------------------------------------------
nfailed=0
nok=0
testcnt=0
load_kind=()
load_name=()
load_cmd=()
# Each check, race and pairs line in this file is one test
total_tests=$(cat $0 ${BASH_SOURCE[0]} | grep -cE '^ *(check "[^$]|race [0-9s]|pairs "[^$])')

phase() {
  echo "==================================================="
  echo "### $*"
  echo "==================================================="
}

info() {
  echo "# $*"
}

# check <what> <condition>: one test, it passes if the condition is true. A
# failed test shows what the condition printed. All that it prints goes to
# $logs/checks.
check() {
  local out rc t start=${test_start:-$(date +%s.%N)}
  unset test_start
  testcnt=$((testcnt + 1))
  echo "--------------------------------------------------------------------------------"
  printf "%04d/%04d %s ### %-6s %s\n" $testcnt $total_tests "$(date +"%x %X")" $category "$1"
  out=$( (eval "$2") 2>&1 )
  rc=$?
  printf '== %s\n%s\n' "$1" "$out" >> $logs/checks
  t=$(awk -v a=$start -v b=$(date +%s.%N) 'BEGIN { printf "%.2f", b - a }')

  if [ $rc = 0 ]; then
    printf '%25s%-35s[\033[1;32m  OK  \033[0;39m]\n' "" "in $t seconds"
    nok=$((nok + 1))
  else
    printf '%25s%-35s[\033[1;31mFAILED\033[0;39m]\n' "" "in $t seconds"
    nfailed=$((nfailed + 1))
    printf '    \033[31;47m%s\033[0m\n' "Full test output:" "==================="
    echo "${out:-(No output)}" | head -40 | while IFS= read -r line; do
      printf '    \033[31;47m%s\033[0m\n' "$line"
    done
  fi

  return $rc
}

# none <command>: true if the command prints nothing. Prints what it printed
# and how many lines.
none() {
  local out
  out=$("$@")
  [ -z "$out" ] && return 0
  echo "$out"
  echo "$(echo "$out" | wc -l) found"
  return 1
}

# Run the command lines all at the same time, print the exit code of each,
# one per line
together() {
  local pids=() c pid
  for c in "$@"; do
    (eval "$c") >/dev/null 2>&1 &
    pids+=($!)
  done

  for pid in ${pids[@]}; do
    wait $pid
    echo $?
  done
}

# race <want> <n> <what> <setup> <command>
race() {
  local want=$1 n=$2 what=$3 cmds=() k
  test_start=$(date +%s.%N)
  (eval "$4") >> $logs/checks 2>&1

  for k in $(seq 1 $n); do
    cmds+=("k=$k; $5")
  done

  ok=$(together "${cmds[@]}" | grep -cx 0)

  if [ $want = some ]; then
    check "$what: 1 or more of $n succeed (got $ok)" "[ $ok -ge 1 ]"
  else
    check "$what: $want of $n succeed (got $ok)" "[ $ok = $want ]"
  fi
}

# pairs <what> <setup> <a> <b>, with the setup for each pair
pairs() {
  local cmds=() k both
  test_start=$(date +%s.%N)

  for k in $(seq 1 8); do
    (eval "$2") >> $logs/checks 2>&1
    cmds+=("k=$k; $3" "k=$k; $4")
  done

  both=$(together "${cmds[@]}" | paste -d ' ' - - | grep -cx "0 0")
  check "$1: in no pair both succeed (both in $both of 8)" "[ $both = 0 ]"
}

# load <kind> <name> <command>
load() {
  load_kind+=("$1")
  load_name+=("$2")
  load_cmd+=("$3")
}

# Run one operation with a time limit of 60 s. Note its name, exit code and
# duration in ms, and the last line of its error output in $logs/errors.
op() {
  local t0=$(date +%s%N) out rc
  out=$(timeout 60 bash -c "$2" 2>&1 >/dev/null)
  rc=$?
  echo "$1 $rc $((($(date +%s%N) - t0) / 1000000))" >> $logs/ops.$BASHPID

  if [ $rc != 0 ]; then
    echo "$1 rc=$rc own=$own wfile=$wfile: $2 : $(echo "$out" | tail -1)" >> $logs/errors
    [ $rc = 124 ] && dump_stacks "$1 timed out: $2"
  fi
}

# Repeat the load lines of kind $1 as worker number $2 until the end
run_worker() {
  local kind=$1 n=${#fsids[@]} k cmds=""
  export w=$2 i=0 d next own old mown wfile fsid fsid2

  for k in ${!load_kind[@]}; do
    [ ${load_kind[$k]} = $kind ] && cmds="$cmds ${load_cmd[$k]}"
  done

  while [ $(date +%s) -lt $end ]; do
    d=$base/d$((i % 4))
    next=$base/d$(((i + 1) % 4))
    own=$d/$kind${w}_$i
    old=$d/$kind${w}_$((i - 8))
    mown=$mnt/${own#/eos/}
    fsid=${fsids[$((i % n))]}
    fsid2=${fsids[$(((i + 1) % n))]}
    wfile=""

    if [[ $cmds == *'$wfile'* ]]; then
      wfile=$(eos ls $d 2>/dev/null | grep -E "^(write|big)[0-9]" | shuf -n 1)
      [ -n "$wfile" ] && wfile=$d/$wfile
    fi

    for k in ${!load_kind[@]}; do
      [ ${load_kind[$k]} = $kind ] || continue
      [[ ${load_cmd[$k]} == *'$wfile'* ]] && [ -z "$wfile" ] && continue
      [[ ${load_cmd[$k]} == *'$old'* ]] && [ $i -lt 8 ] && continue
      op ${load_name[$k]} "${load_cmd[$k]}"
    done

    i=$((i + 1))
  done
}

# Start 2 workers of each kind, a probe of the MGM and the drain. When they
# end, print the count, errors, timeouts and longest duration of each operation.
run_load() {
  local kind n
  eos rm -r -F $r >/dev/null 2>&1
  kinds=$(printf '%s\n' "${load_kind[@]}" | awk '!seen[$0]++' |
            grep -vxF -f <(printf '%s\n' $skip) | xargs)
  info "worker kinds: $kinds"
  files_before=$(eos ns stat -m | tr ' ' '\n' | grep "^ns.total.files=" | cut -d= -f2)
  log_lines=$(wc -l < $mgmlog 2>/dev/null || echo 0)
  end=$(($(date +%s) + duration))
  # On an interrupt, stop the workers and undo the drain
  trap 'kill $(jobs -p) 2>/dev/null; undrain; unmount; exit 2' INT TERM
  probe &
  drain &

  for n in 1 2; do
    for kind in $kinds; do
      run_worker $kind $n &
    done
  done

  wait
  undrain
  unmount
  awk '{ n[$1]++; if ($2 == 124) tmo[$1]++; else if ($2) err[$1]++
         if ($3 > max[$1]) max[$1] = $3 }
       END { for (o in n) printf "%-24s %7d %7d %8d %7d\n", o, n[o], err[o], tmo[o], max[o] }' \
    $logs/ops.* | sort > $logs/summary
  printf "  %-24s %7s %7s %8s %7s\n" op count errors timeouts maxms
  sed 's/^/  /' $logs/summary
}

# The number of failed and passed tests and the logs, then exit
finish() {
  echo "--------------------------------------------------------------------------------"
  echo "Failed: $nfailed Success: $nok"
  echo "#--------------------------------------------------------------"
  echo "# Output of each test             : $logs/checks"
  echo "# Errors of the worker operations : $logs/errors"
  [ -d $logs/stacks ] &&
    echo "# MGM stacks at the first hang    : $logs/stacks/mgm.txt"
  echo "#--------------------------------------------------------------"
  [ $nfailed = 0 ]
  exit
}

# ------------------------------------------------------------------------------
# Functions for the commands of the tests
# ------------------------------------------------------------------------------
# md_field <path> <key>: one value of "eos fileinfo -m"
md_field() {
  eos fileinfo $1 -m 2>/dev/null | tr ' ' '\n' | grep "^$2=" | head -1 | cut -d= -f2
}

# drop_replica <file>: drop the first replica if the file has 2 or more. eos
# file drop also drops the last one, and two workers that drop one replica
# each would leave the file without data.
drop_replica() {
  local md nrep
  md=$(eos fileinfo $1 -m 2>/dev/null | tr ' ' '\n')
  nrep=$(grep -m1 "^nrep=" <<< "$md" | cut -d= -f2)
  [ "${nrep:-0}" -ge 2 ] || return 0
  eos file drop $1 $(grep -m1 "^fsid=" <<< "$md" | cut -d= -f2)
}

# "<uid> <gid> <key>" of each recycle bin entry under <path>
recycle_entries() {
  eos recycle ls -m -n --all 2>/dev/null | grep -F "restore-path=$1" |
    sed -E 's/.* uid=([0-9]+) gid=([0-9]+) .*restore-key=([^ ]+).*/\1 \2 \3/'
}

# recycle <"restore -f" or "purge -k"> <path>: act on the recycle bin entry of
# <path> as its owner. Only the owner may.
recycle() {
  local uid gid key
  read uid gid key <<< "$(recycle_entries "$2 ")"
  eos -r $uid $gid recycle $1 $key
}

# rest_call <command> <path>: a request to the REST gateway
rest_call() {
  curl -fs -m 60 -X POST $rest/$1 -d "{\"md\":{\"path\":\"$(echo -n $2 | base64 -w0)\"}}"
}

export -f md_field drop_replica recycle_entries recycle rest_call

# "<fid> <fsid>" of each file location under <dir> (default: the test tree),
# as the files say
file_locations() {
  eos find -f --fid --fs ${1-$base} 2>/dev/null |
    awk '{ fid = substr($2, 5); n = split(substr($3, 6), l, ",")
           for (k = 1; k <= n; k++) if (l[k] != "") print fid, l[k] }' | sort
}

# "<bytes> <files>" of the quota node. The MGM refreshes what quota ls shows
# at most once a minute, so wait for that first.
project_quota() {
  sleep 61
  eos quota ls -m -p $base | grep gid=project |
    sed -E 's/.*usedlogicalbytes=(-?[0-9]+) usedfiles=(-?[0-9]+).*/\1 \2/'
}

# ------------------------------------------------------------------------------
# Background tasks of the load and clean up
# ------------------------------------------------------------------------------
# Ask the MGM every 2 s if it answers
probe() {
  while [ $(date +%s) -lt $end ]; do
    timeout 15 eos ns stat >/dev/null 2>&1 ||
      { date +%T >> $logs/probe.fail; dump_stacks "the MGM did not answer"; }
    sleep 2
  done
}

# Save the MGM thread stacks, once
dump_stacks() {
  mkdir $logs/stacks 2>/dev/null || return 0
  echo "$(date +%T) $*" > $logs/stacks/mgm.txt
  eu-stack -p $(pgrep -f "xrootd -n mgm" | head -1) >> $logs/stacks/mgm.txt 2>&1
}

# Drain a file system with files of the test during the load, so that the
# drainer moves replicas under the workers. Then set it back to rw. Not a file
# system with a replica of the append files: the MGM refuses an append
# (ENETUNREACH) while one replica is on a draining file system.
drain() {
  local fsid
  sleep $((duration / 4))
  fsid=$(file_locations | awk '{ print $2 }' | sort -u |
           grep -vxF -f <(file_locations $base/ap | awk '{ print $2 }') | head -1)
  [ -n "$fsid" ] || return
  echo $fsid > $logs/drain.fsid
  op drain "eos fs config $fsid configstatus=drain"
  sleep $((end - $(date +%s))) 2>/dev/null
  op undrain "eos fs config $fsid configstatus=rw"
  rm -f $logs/drain.fsid
}

undrain() {
  [ -s $logs/drain.fsid ] && eos fs config $(cat $logs/drain.fsid) configstatus=rw >/dev/null 2>&1
  rm -f $logs/drain.fsid
}

# Unmount eosxd and wait until it exits, as it still flushes writes
unmount() {
  local k
  mountpoint -q $mnt 2>/dev/null || return 0
  umount $mnt 2>/dev/null || umount -l $mnt

  for k in $(seq 1 30); do
    pgrep -f "eosxd.*$mnt" >/dev/null || return 0
    sleep 1
  done
}

# rm -r does not remove a quota node, so remove the node first
remove_test_tree() {
  recycle_entries $base/ | while read uid gid key; do
    eos -r $uid $gid recycle purge -k $key >/dev/null 2>&1
  done

  eos quota rmnode -p $base >/dev/null 2>&1
  eos rm -r -F $base >/dev/null 2>&1
}

# ------------------------------------------------------------------------------
# Set up
# ------------------------------------------------------------------------------
setup() {
  local k
  phase "Set up $base"
  # Two runs on one instance remove each other's files and logs
  exec 9> /tmp/eos-contention-test.lock
  flock -n 9 || { echo "another eos-contention-test runs on this host"; exit 2; }
  # A mount left by an interrupted run must go before rm of its directory
  umount -l $mnt 2>/dev/null
  rm -rf --one-file-system $logs && mkdir -p $logs
  head -c 1024 /dev/urandom > $src
  head -c 1024 /dev/urandom > $srcb
  head -c 8388608 /dev/urandom > $srcbig
  : > $empty
  yes | head -c 1024 > $logs/race.1k
  remove_test_tree
  eos mkdir -p $base || exit 2
  eos chmod 777 $base >/dev/null
  eos attr set default=replica $base >/dev/null
  eos quota set -g 99 -v 1TB -i 1M $base >/dev/null || exit 2

  for k in d0 d1 d2 d3 v hot big at ap race; do
    eos mkdir $base/$k >/dev/null || exit 2
    eos chmod 777 $base/$k >/dev/null
  done

  # Writes through xrootd run as adm (3:4) with sss. A rename by adm fails with
  # EPERM in a directory of root.
  for k in d0 d1 d2 d3; do
    eos chown adm:adm $base/$k >/dev/null
  done

  eos attr set sys.versioning=2 $base/v >/dev/null
  eos attr set sys.forced.checksum=adler $r >/dev/null

  # A new instance refuses writes until its file systems report their free
  # space. The first file also marks the first id of the test: files and
  # directories with a higher id belong to the test.
  for k in $(seq 1 60); do
    xrdcp -f -s $src $url/$base/watermark >/dev/null 2>&1 && break
    sleep 5
  done

  first_fid=$(md_field $base/watermark fid)
  first_cid=$(md_field $base fid)
  [ -n "$first_fid" ] || { echo "the instance refuses writes"; exit 2; }
  xrdcp -f -s $src $url/$hot >/dev/null 2>&1

  # The recycle bin, gRPC, the REST gateway and eosxd can be missing: skip
  # the load kinds that need them
  skip=""
  # rm refuses to recycle when no quota node covers the recycle bin
  recycle_ok=0
  eos recycle config --dump 2>/dev/null | grep -qx enabled=on &&
    eos mkdir $base/r >/dev/null && eos chmod 777 $base/r >/dev/null &&
    eos recycle config --add-bin $base/r >/dev/null &&
    eos quota ls -m -p "$(eos attr get sys.recycle $base/r | cut -d '"' -f2)" \
      >/dev/null 2>&1 && recycle_ok=1
  [ $recycle_ok = 1 ] ||
    { info "skip the recycle bin parts: the recycle bin is off or has no quota"
      skip="$skip recycle"; }
  timeout 10 $grpc -p $base/g mkdir >/dev/null 2>&1 &&
    timeout 10 $grpc -p $base/g rmdir >/dev/null 2>&1 ||
    { info "skip grpc: no namespace gRPC service on $grpc_ep"; skip="$skip grpc"; }
  rest_call ls_cmd $base >/dev/null 2>&1 ||
    { info "skip rest: no REST gateway on $rest"; skip="$skip rest"; }

  # Without a configuration file eosxd needs a host name with a domain
  mkdir -p $mnt

  if eosxd -ofsname=$host.localdomain:/eos $mnt > $logs/eosxd.log 2>&1 9>&-; then
    for k in $(seq 1 30); do
      mkdir $mnt/${base#/eos/}/probe 2>/dev/null && break
      sleep 1
    done
  fi

  rmdir $mnt/${base#/eos/}/probe 2>/dev/null ||
    { info "skip mount: no eosxd mount of $host.localdomain:/eos"; skip="$skip mount"; unmount; }

  members=$(awk '$1 == "mgmofs.qdbcluster" { print $2 }' /etc/xrd.cf.mgm 2>/dev/null)
  pwfile=$(awk '$1 == "mgmofs.qdbpassword_file" { print $2 }' /etc/xrd.cf.mgm 2>/dev/null)
  qdb="--members $members --password-file $pwfile"
  fsids=($(eos fs ls -m | grep -oE " id=[0-9]+" | cut -d= -f2))
  info "logs in $logs"
}

# ------------------------------------------------------------------------------
# End checks
# ------------------------------------------------------------------------------
end_checks() {
  local k fsid
  # The other checks would wait for a hung MGM
  check "the MGM answered every 2 s during the load" 'none grep -s . $logs/probe.fail' ||
    finish
  awk '$4 > 0 { print $1 }' $logs/summary > $logs/hung
  awk '$1 !~ /^(other|race)_/ && $3 > 0 { print $1 }' $logs/summary > $logs/failed
  check "the workers ran operations" '[ -s $logs/summary ]'
  check "no operation hung" 'none cat $logs/hung'
  check "no operation on own entries failed" 'none cat $logs/failed'
  check "every read of the atomic upload got one whole version" \
    'none grep -s . $logs/atomic.bad'

  sort $logs/appends 2>/dev/null | uniq -c | while read n f; do
    [ "$(md_field $f size)" = $((n * 4096)) ] || echo $f
  done > $logs/appends.bad
  check "every appended file has the size of its appends" 'none cat $logs/appends.bad'

  # Conversions and replica changes go on after the load. Wait until no
  # conversion runs and the file locations stay the same for 10 s.
  for k in $(seq 1 60); do
    eos convert config list 2>&1 | grep -qE "(Running|Pending) jobs *: [1-9]" || break
    sleep 5
  done

  file_locations > $logs/locations
  for k in $(seq 1 30); do
    sleep 10
    file_locations > $logs/locations.new
    cmp -s $logs/locations $logs/locations.new && break
    mv $logs/locations.new $logs/locations
  done

  for fsid in ${fsids[@]}; do
    eos fs dumpmd $fsid -m | grep -F "&container=$base/" |
      sed -E "s/.*&id=([0-9]+)&.*/\1 $fsid/"
  done | sort > $logs/locations.fs
  check "the file system lists hold exactly the file locations" \
    'diff $logs/locations $logs/locations.fs'

  eos find -f $base 2>/dev/null | grep -v " -> " | while read f; do
    eos file check $f %size%checksum%silent >/dev/null 2>&1 || echo $f
  done > $logs/replicas.bad
  check "the FST replicas have the size and checksum of the namespace" \
    'none cat $logs/replicas.bad'

  [ $recycle_ok = 1 ] &&
    check "the recycle bin holds no entry of the test" 'none recycle_entries $base/'
  check "the quota file count matches a recompute" \
    'a=$(project_quota | cut -d " " -f2); eos ns recompute_quotanode $base >/dev/null
     b=$(project_quota | cut -d " " -f2); echo "$a, recomputed $b"
     [ -n "$a" ] && [ "$a" = "$b" ]'

  for k in $(eos ls $base); do
    eos rm -r -F $base/$k >/dev/null 2>&1
  done

  check "the quota is 0 after rm of everything" \
    'q=$(project_quota); echo "$q"; [ "$q" = "0 0" ]'
  remove_test_tree

  # A removed file leaves the namespace when the FSTs have dropped its
  # replicas. A record written back after its removal would stay.
  check "no file record of the test is left" \
    'for k in $(seq 1 60); do
       n=$(eos ns stat -m | tr " " "\n" | grep "^ns.total.files=" | cut -d= -f2)
       [ $n -le $files_before ] && exit 0
       sleep 5
     done
     echo "files before $files_before, after $n"; exit 1'

  # In the whole namespace in QuarkDB, no file or directory with an id of the
  # test may be an orphan, and no file system list may hold such a file. A
  # file with parent 0 and only unlinked locations waits for the FSTs, that is
  # fine.
  if eos-ns-inspect check-orphans $qdb > $logs/orphans.all 2>&1; then
    awk -v f=$first_fid -v c=$first_cid '
      /^file-id=/ { split($1, a, "="); split($2, p, "="); split($4, l, "=")
                    split($5, u, "=")
                    if (a[2] >= f && (p[2] != 0 || l[2] != "" || u[2] == "")) print }
      /^container-id=/ { split($1, a, "="); if (a[2] >= c) print }' \
      $logs/orphans.all > $logs/orphans

    for k in check-fsview-missing check-fsview-extra; do
      eos-ns-inspect $k $qdb 2>/dev/null |
        awk -v f=$first_fid '/^id=/ { split($1, a, "="); if (a[2] >= f) print }'
    done > $logs/fsview.bad

    check "no file or directory of the test is an orphan" 'none cat $logs/orphans'
    check "no file system list holds a file of the test" 'none cat $logs/fsview.bad'
  else
    info "skip the QuarkDB checks: eos-ns-inspect cannot reach QuarkDB"
  fi

  tail -n +$((log_lines + 1)) $mgmlog > $logs/mgm.log 2>/dev/null
  check "no CRIT message in the MGM log" 'none grep level=CRIT $logs/mgm.log'
}
