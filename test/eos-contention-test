#!/bin/bash
# ------------------------------------------------------------------------------
# Contention test
#
# Many clients change the same files and directories at the same time, through
# xrootd, the console, gRPC, REST and an eosxd mount. The test fails if an
# operation hangs, or if the namespace, the quota and the file systems do not
# agree at the end.
#
# Usage: eos-contention-test <prefix> [<seconds>]
#
# Run it on the MGM host of a test instance with no other activity: some
# checks compare the whole namespace before and after the test. It works in
# <prefix>/contention, with the shared directories d0 .. d3. The load runs for
# <seconds> (default 120), while one file system is drained.
#
# How to add a test:
#
#   A race       race <want> <n> <what> <setup> <command>
#                  n copies of the command at the same time, <want> of them
#                  must succeed: a number, or "some" for 1 or more
#                pairs <what> <setup> <command a> <command b>
#                  8 pairs at the same time, in no pair may both succeed
#                check <what> <condition>
#                  for the state after the race
#   A load       load <kind> <name> <command>
#   operation      2 workers of each kind repeat all lines of their kind, in
#                  order, until the end of the load. A new kind needs only
#                  its lines.
#
# Commands and conditions are shell code in single quotes. They see the
# settings below ($url, $base, $src ...). In races, $k is the number of the
# copy or the pair, and $ok the number of successes of the last race. In the
# load, the commands also see:
#   $w $i         the worker number and the step number
#   $d $next      the shared directory of the step and the next one
#   $own          a new name for each step: $d/<kind><w>_<i>
#   $old          the $own of 8 steps ago (the line waits for step 8)
#   $mown         $own through the eosxd mount
#   $wfile        a file of the write and big workers in $d (the line is
#                 skipped if there is none)
#   $fsid $fsid2  two file system ids
#
# An operation of a worker on its own entries must succeed. Operations named
# other_* use entries of other workers, and race_* entries that several
# workers share: these can fail, but they must not hang. At the first hang
# the test saves the MGM thread stacks in the log directory.
# ------------------------------------------------------------------------------

[ -n "$1" ] || { echo "usage: $0 <prefix> [<seconds>]"; exit 2; }
# The commands of the load run in their own shell: export the settings
set -a
# A deadlocked MGM never answers. Every xrootd client, the console too, gives
# up a request after 60 s, so that the test ends.
XRD_REQUESTTIMEOUT=60
base=$1/contention
duration=${2-120}
host=localhost
url=root://$host
grpc_ep=$host:50051
grpc="eos-grpc-ns --endpoint $grpc_ep"
rest=http://127.0.0.1:40054/v1/eos/rest/gateway
logs=${TMPDIR:-/tmp}/eos-contention-test
mnt=$logs/mnt
src=$logs/file.1k
srcb=$logs/file.1k.b
srcbig=$logs/file.8m
empty=$logs/file.0
hot=$base/hot/h
r=$base/race
mgmlog=/var/log/eos/mgm/xrdlog.mgm
set +a
# The test framework, the set up and the end checks
source "$(dirname "$(readlink -f "$0")")/eos-contention-test-utils" || exit 2

setup

# ----------------------------------------------------------------------------
phase "Races"
category=Race

# Two clients append to one file at the same time
check "2 overlapping appends succeed" \
  'xrdcp -s $logs/race.1k $url/$r/append &&
   xrdcpappendoverlap root://123@$host/$r/append root://124@$host/$r/append'
check "the checksum covers both appends" \
  'sleep 1; eos fileinfo $r/append --checksum | grep -q fc46d811'

race 1 8 "mkdir of one directory" '' 'xrdfs $url mkdir $r/dir'
race 8 8 "mkdir -p of one new path" '' 'eos mkdir -p $r/deep/a/b/c/d'
race 1 8 "creates of one new file" '' 'xrdcp -s $src $url/$r/new'

# Not eos rm: it reports a missing file as success
race 1 8 "rm of one file" 'xrdcp -s $src $url/$r/rm' 'xrdfs $url rm $r/rm'
check "the removed file is gone" '! eos stat $r/rm'

race some 8 "overwrites of one file" '' 'xrdcp -f -s $src $url/$r/over'
check "the overwritten file has 1024 bytes and 2 replicas" \
  '[ "$(md_field $r/over size) $(md_field $r/over nrep)" = "1024 2" ]'

race 1 8 "renames of one file" 'xrdcp -s $src $url/$r/mv' \
  'xrdfs $url mv $r/mv $r/mv.$BASHPID'
check "1 copy of the renamed file is left" '[ $(eos ls $r | grep -c "^mv") = 1 ]'

# Each successful rename removes one source, so the sources left plus the
# target are 9 minus the successes
race some 8 "renames of 8 files onto one name" \
  'for k in $(seq 1 8); do xrdcp -s $src $url/$r/s$k; done' \
  'xrdfs $url mv $r/s$k $r/target'
check "the renames onto one name keep the files" \
  'n=$(eos ls $r | grep -cE "^(s[1-8]|target)$"); echo "$n left after $ok moves"
   [ $n = $((9 - ok)) ]'

# If both renames succeed, a and b are cut off from the namespace
pairs "renames of a into b and of b into a" \
  'eos mkdir -p $r/c$k/a && eos mkdir $r/c$k/b' \
  'xrdfs $url mv $r/c$k/a $r/c$k/b/a' 'xrdfs $url mv $r/c$k/b $r/c$k/a/b'
check "the renamed directories stay reachable" \
  'for k in $(seq 1 8); do [ $(eos find -d $r/c$k | wc -l) = 3 ] || exit 1; done'

# If both succeed, x has no parent
pairs "rmdir of e and mkdir of e/x" 'eos mkdir $r/e$k' \
  'xrdfs $url rmdir $r/e$k' 'xrdfs $url mkdir $r/e$k/x'

# If both succeed, the file is in a removed directory
pairs "move of a file into t and rmdir of t" \
  'eos mkdir $r/t$k && xrdcp -s $src $url/$r/f$k' \
  'xrdfs $url mv $r/f$k $r/t$k/f$k' 'xrdfs $url rmdir $r/t$k'
check "each moved file exists once" '[ $(eos find -f $r | grep -cE "/f[1-8]$") = 8 ]'

if [ $recycle_ok = 1 ]; then
  race 1 4 "restores of one recycle bin entry" \
    'xrdcp -s $src $url/$base/r/rr && eos rm $base/r/rr' \
    'recycle "restore -f" $base/r/rr'
  check "the restored file is back" 'eos stat $base/r/rr'
fi

race 8 8 "touch of one new file" '' 'eos file touch $r/touch'
check "the touched file exists once" '[ $(eos ls $r | grep -cx touch) = 1 ]'

# If both succeed, x has no parent
pairs "touch of e/x and rmdir of e" 'eos mkdir $r/te$k' \
  'eos file touch $r/te$k/x' 'xrdfs $url rmdir $r/te$k'

race 1 8 "register of one new name" '' 'eos register $r/reg size=0'
check "the registered file exists" 'eos stat $r/reg'

# Each overwrite commits a new version of the file
race some 8 "overwrites of one versioned file" \
  'eos mkdir $r/vv && eos chmod 777 $r/vv && eos attr set sys.versioning=3 $r/vv' \
  'xrdcp -f -s $src $url/$r/vv/f'
check "the versioned file has 1024 bytes and at most 3 versions" \
  'n=$(eos ls "$r/vv/.sys.v#.f" 2>/dev/null | wc -l); echo "$n versions"
   [ "$(md_field $r/vv/f size)" = 1024 ] && [ $n -le 3 ]'

# An open of an existing file with an OwnCloud chunk id is refused, without
# a stall that the client retries until its timeout
check "an open of an existing file with oc-chunk-uuid fails at once" \
  'xrdcp -s $src $url/$r/oc || exit
   timeout 20 xrdcp -f -s $src "$url/$r/oc?oc-chunk-uuid=abc"; rc=$?
   echo "rc=$rc"; [ $rc != 0 ] && [ $rc != 124 ]'

# The delete workflow holds rm, and the removal of a rename target, for 3 s.
# What a rename changes meanwhile must not get lost.
wfe=$(eos space status default -m | tr ' ' '\n' | sed -n 's/^wfe=//p')
eos space config default space.wfe=on >/dev/null
eos mkdir $r/w && eos chmod 777 $r/w >/dev/null
eos attr set 'sys.workflow.sync::delete.default=bash:shell:slow sleep 3' $r/w >/dev/null

check "two overwrite renames onto one file both succeed" \
  'for x in x y t; do xrdcp -s $src $url/$r/w/$x || exit; done
   eos file rename $r/w/x $r/w/t & sleep 1; eos file rename $r/w/y $r/w/t || exit
   wait $! && eos stat $r/w/t && ! eos stat $r/w/x && ! eos stat $r/w/y'
check "an overwrite rename moves when its target is renamed away meanwhile" \
  'xrdcp -s $src $url/$r/w/s && xrdcp -s $src $url/$r/w/t2 || exit
   eos file rename $r/w/s $r/w/t2 & sleep 1; eos file rename $r/w/t2 $r/w/u
   wait $! && eos stat $r/w/t2 && eos stat $r/w/u && ! eos stat $r/w/s'

if [[ " $skip " != *" mount "* ]]; then
  mr=$mnt/${r#/eos/}
  check "rm of a hard link target keeps the file that a rename moved meanwhile" \
    'cp $src $mr/w/a && ln $mr/w/a $mr/w/l && sync && sleep 2 || exit
     xrdfs $url rm $r/w/a & sleep 1; eos file rename $r/w/a $r/w/b; wait
     eos stat $r/w/b'
fi

eos attr rm sys.workflow.sync::delete.default $r/w >/dev/null

# A create that the create workflow refuses removes the new file. If it
# leaves the file in the quota, the quota end checks find the leak.
eos mkdir $r/wc && eos chmod 777 $r/wc >/dev/null
eos attr set 'sys.workflow.sync::create.default=bash:shell:fail false' $r/wc >/dev/null
race 0 8 "creates that the create workflow refuses" '' \
  'xrdcp -s $src $url/$r/wc/f$k'
check "the refused creates leave no file" 'none eos ls $r/wc'
eos attr rm sys.workflow.sync::create.default $r/wc >/dev/null
eos space config default space.wfe=${wfe:-off} >/dev/null

if [[ " $skip " != *" mount "* ]]; then
  # A hard link entry is not in the quota: the quota end checks find an rm,
  # or a symlink renamed over it, that takes it out
  check "hard links through eosxd: rm of both names, a symlink moved over one" \
    'cp $src $mr/q1 && ln $mr/q1 $mr/q2 && sync && sleep 2 &&
     eos rm $r/q1 && eos rm $r/q2 &&
     cp $src $mr/q3 && ln $mr/q3 $mr/q4 && ln -s q3 $mr/q5 && sync && sleep 2 &&
     mv -f $mr/q5 $mr/q4'

  check "rename_with_symlink and a FUSE move of one file leave one file" \
    'for k in $(seq 1 16); do
       for x in a b c; do
         eos mkdir -p $r/rs$k/$x && eos chmod 777 $r/rs$k/$x >/dev/null || exit
       done
       xrdcp -s $src $url/$r/rs$k/a/f && ls $mr/rs$k/a >/dev/null || exit
       together "mv $mr/rs$k/a/f $mr/rs$k/c/f" \
         "eos file rename_with_symlink $r/rs$k/a/f $r/rs$k/b" >/dev/null
     done; sleep 1
     bad=$(for k in $(seq 1 16); do
       n=0
       for e in $(eos find -f $r/rs$k); do
         l=$(md_field $e link)
         if [ -z "$l" ]; then n=$((n + 1)); else eos stat $l >/dev/null 2>&1 || echo "$e -> $l dangles"; fi
       done
       [ $n = 1 ] || echo "rs$k has $n files"
     done)
     [ -z "$bad" ] || { echo "$bad"; exit 1; }'

  check "eos acl and a FUSE chmod of one directory keep both changes" \
    'for k in $(seq 1 16); do
       eos mkdir $r/ac$k && eos chmod 755 $r/ac$k >/dev/null && stat $mr/ac$k >/dev/null || exit
       together "chmod 700 $mr/ac$k" "eos acl --sys u:99=rx $r/ac$k" >/dev/null
     done; sleep 1
     bad=$(for k in $(seq 1 16); do
       m=$(md_field $r/ac$k mode); a=$(eos attr get sys.acl $r/ac$k 2>&1)
       [ "$m" = 40700 ] && [[ $a == *u:99* ]] || echo "ac$k mode=$m $a"
     done)
     [ -z "$bad" ] || { echo "$bad"; exit 1; }'

  # eosxd replies before the MGM has done the change: check the namespace,
  # not the exit codes. If both moves succeed, a and b are cut off.
  check "a FUSE move of a into b and a move of b into a keep both reachable" \
    'for k in $(seq 1 8); do
       eos mkdir -p $r/fm$k/a && eos mkdir $r/fm$k/b && eos chmod -r 777 $r/fm$k >/dev/null &&
         ls $mr/fm$k/a $mr/fm$k/b >/dev/null || exit
       together "mv $mr/fm$k/a $mr/fm$k/b/a" "xrdfs $url mv $r/fm$k/b $r/fm$k/a/b" >/dev/null
     done; sleep 2
     bad=$(for k in $(seq 1 8); do
       [ $(eos find -d $r/fm$k | wc -l) = 3 ] || echo "fm$k is cut off"
     done)
     [ -z "$bad" ] || { echo "$bad"; exit 1; }'

  # If the rmdir wins over a create that succeeded, the file has no parent
  check "a FUSE rmdir of e and a create of e/f keep each created file" \
    'for k in $(seq 1 8); do
       eos mkdir $r/fe$k && eos chmod 777 $r/fe$k >/dev/null && ls $mr/fe$k >/dev/null || exit
     done
     rcs=$(for k in $(seq 1 8); do
       together "rmdir $mr/fe$k" "xrdcp -s $src $url/$r/fe$k/f" | tail -1
     done); sleep 2
     k=0; bad=$(for rc in $rcs; do
       k=$((k + 1)); [ $rc != 0 ] || eos stat $r/fe$k/f >/dev/null 2>&1 || echo "fe$k/f is lost"
     done)
     [ -z "$bad" ] || { echo "$bad"; exit 1; }'

  # FUSE and console renames replace the target. A replaced file that stays in
  # the quota or the namespace fails the end checks.
  check "FUSE and console overwrite renames of 8 files onto one name leave whole files" \
    'eos mkdir $r/fo && eos chmod 777 $r/fo >/dev/null || exit
     for k in $(seq 1 8); do xrdcp -s $src $url/$r/fo/s$k || exit; done
     ls $mr/fo >/dev/null; cmds=()
     for k in 1 2 3 4; do
       cmds+=("mv -f $mr/fo/s$k $mr/fo/t" "eos file rename $r/fo/s$((k + 4)) $r/fo/t")
     done
     together "${cmds[@]}" >/dev/null; sleep 2; echo $(eos ls $r/fo)
     eos ls $r/fo | grep -vxE "s[1-8]|t" && exit 1
     [ "$(md_field $r/fo/t size)" = 1024 ]'
fi

# Copy-on-write clone: an rm or an overwrite of a file in a cloned directory
# keeps the old version in <proc>/clone/<clone id>/<dir id>/<file id>
proc=$(echo $base | cut -d/ -f1-3)/proc
cl_changed="o rm p1 p2 p3 p4 p5 p6 p7 p8"
[[ " $skip " != *" mount "* ]] && cl_changed="$cl_changed m1 m3"

if eos stat $proc/clone >/dev/null 2>&1; then
  # A clone id of 0 to 9 only marks the directory. The clone id is the time,
  # so wait 1 s: two clones in one second fail.
  race some 8 "overwrites of one cloned file" \
    'eos mkdir $r/cl && eos chmod 777 $r/cl >/dev/null || exit
     for x in $cl_changed m2; do xrdcp -s $src $url/$r/cl/$x || exit; done
     sleep 1; eos oldfind -x sys.clone=+10 $r/cl | head -1 | cut -d" " -f2 |
       cut -d: -f2 > $logs/clone.id
     cid=$(printf %x $(md_field $r/cl fid))
     for x in $cl_changed; do
       echo $proc/clone/$(cat $logs/clone.id)/$cid/$(printf %x $(md_field $r/cl/$x fid))
     done > $logs/clone.paths' \
    'xrdcp -f -s $src $url/$r/cl/o'
  check "the overwritten cloned file has 1024 bytes and 2 replicas" \
    '[ "$(md_field $r/cl/o size) $(md_field $r/cl/o nrep)" = "1024 2" ]'

  race 1 8 "rm of one cloned file" '' 'xrdfs $url rm $r/cl/rm'

  check "rm and overwrite of one cloned file at once leave no file or a whole one" \
    'for k in $(seq 1 8); do
       together "xrdfs $url rm $r/cl/p$k" "xrdcp -f -s $src $url/$r/cl/p$k" >/dev/null
     done
     bad=$(for k in $(seq 1 8); do
       eos stat $r/cl/p$k >/dev/null 2>&1 || continue
       [ "$(md_field $r/cl/p$k size)" = 1024 ] || echo "p$k is not whole"
     done)
     [ -z "$bad" ] || { echo "$bad"; exit 1; }'

  if [[ " $skip " != *" mount "* ]]; then
    check "FUSE rm and mv -f over cloned files" \
      'rm -f $mr/cl/m1 && mv -f $mr/cl/m2 $mr/cl/m3 && sync && sleep 2 || exit
       ! eos stat $r/cl/m1 && ! eos stat $r/cl/m2 && eos stat $r/cl/m3'
  fi

  check "the clone holds the old version of each changed file" \
    'bad=$(for p in $(cat $logs/clone.paths); do
       eos stat $p >/dev/null 2>&1 || echo "$p is missing"
     done)
     [ -s $logs/clone.paths ] && [ -z "$bad" ] || { echo "$bad"; exit 1; }'
  # The clone files are not in the test tree: the end checks would not find
  # them, and the namespace would keep them
  check "the clean up of the clone removes its directory" \
    'id=$(cat $logs/clone.id); [ -n "$id" ] || exit
     eos oldfind -x sys.clone=-$id $r/cl >/dev/null; ! eos stat $proc/clone/$id'
fi

# ----------------------------------------------------------------------------
phase "Load: 2 workers of each kind for $duration s"

# Files that the other workers use as $wfile, read back and removed 8 steps
# later. A conversion can move the replicas under the read.
#    kind    operation            command
load write   write                'xrdcp -f -s $src $url/$own'
load write   other_read           'xrdcp -f -s $url/$old /dev/null'
load write   rm                   'eos rm -F $old'
load big     write                'xrdcp -f -s $srcbig $url/$own'
load big     other_read           'xrdcp -f -s $url/$old /dev/null'
load big     rm                   'eos rm -F $old'

# Uploads that stop without a close (xrdcpabort always fails)
load abort   other_abort          'xrdcpabort $url/$own'
load abort   other_abort_atomic   'xrdcpabort "$url/$own.a?eos.atomic=1"'
load abort   other_rm             'eos rm -F $own'

# A file, and a directory with a file in it, move from one shared directory
# to the next
load rename  write                '[ $i != 0 ] || xrdcp -s $src $url/$d/n$w'
load rename  mkdir                '[ $i != 0 ] || eos mkdir $d/nd$w'
load rename  write                '[ $i != 0 ] || xrdcp -s $src $url/$d/nd$w/f'
load rename  rename               'xrdfs $url mv $d/n$w $next/n$w'
load rename  rename_dir           'xrdfs $url mv $d/nd$w $next/nd$w'

load dir     mkdir                'xrdfs $url mkdir $own'
load dir     rmdir                'xrdfs $url rmdir $own'
load dir     symlink              'eos ln $own.l $d'
load dir     rm_link              'eos rm -F $own.l'

load meta    attr_dir             'eos attr set user.contention=$i $d'
load meta    chmod_dir            'eos chmod 777 $d'
load meta    chown_dir            'eos chown adm:adm $d'
load meta    other_attr           'eos attr set user.contention=$i $wfile'
load meta    other_chmod          'xrdfs $url chmod $wfile rw-r--r--'
load meta    other_chown          'eos chown adm:adm $wfile'

# Lookups through xrootd, the console, the proc calls of the FUSE clients
# and the REST gateway
load read    stat                 'xrdfs $url stat $d'
load read    ls                   'eos ls -l $d'
load read    fileinfo_dir         'eos -j fileinfo $d'
load read    other_fileinfo       'eos -j fileinfo $wfile'
load read    fuse_ls              'xrdcp -f -s "$url//proc/user/?mgm.cmd=fuse&mgm.statentries=1&mgm.path=$d" /dev/null'
load read    fusex_get            'xrdcp -f -s "$url//proc/user/?mgm.cmd=fuseX&mgm.op=GET&mgm.path=$d" /dev/null'
load read    other_fusex_get      'xrdcp -f -s "$url//proc/user/?mgm.cmd=fuseX&mgm.op=GET&mgm.path=$wfile" /dev/null'
load rest    rest_ls              'rest_call ls_cmd $d'
load rest    other_rest_fileinfo  'rest_call fileinfo_cmd $wfile'

# Walks over the file system lists and the test tree. Not fs dropdeletion:
# it leaves the records of the dropped files, and an end check counts them.
load walk    fs_status            'eos fs status $fsid'
load walk    fs_dumpmd            'eos fs dumpmd $fsid --path'
load walk    fs_compare           'eos fs compare $fsid $fsid2'
load walk    fs_dropghosts        'eos fs dropghosts $fsid'
load walk    fsck_report          'eos fsck report'
load walk    find                 'eos find --count $base'
load walk    find_fs              'eos find -f --fid --fs --checksum $base'
load walk    oldfind              'eos oldfind -f $base'
load walk    quota_ls             'eos quota ls -m -p $base'

# Write, rm, rename, mkdir and rmdir of the same 3 names
load clash   race_write           'xrdcp -f -s $src $url/$base/d0/c$((RANDOM % 3))'
load clash   race_rm              'eos rm -F $base/d0/c$((RANDOM % 3))'
load clash   race_rename          'xrdfs $url mv $base/d0/c$((RANDOM % 3)) $base/d1/c$((RANDOM % 3))'
load clash   race_mkdir           'xrdfs $url mkdir $base/d2/c$((RANDOM % 3))'
load clash   race_rmdir           'xrdfs $url rmdir $base/d2/c$((RANDOM % 3))'
load clash   race_attr            'eos attr set user.contention=$i $base/d1/c$((RANDOM % 3))'

# The cache drops make the next lookup read QuarkDB again
load replica other_drop           'drop_replica $wfile'
load replica other_adjustreplica  'eos file adjustreplica $wfile'
load replica other_verify         'eos file verify $wfile -checksum -commitchecksum -commitsize'
load replica other_convert        'eos convert file $wfile replica:2'
load replica other_evict          'eos evict $wfile'
load replica other_fsck_repair    'eos fsck repair --fxid $(md_field $wfile fxid)'
load replica race_cache_file      'eos ns cache drop-single-file $(md_field $wfile fid)'
load replica race_cache_dir       'eos ns cache drop-single-container $(md_field $d fid)'

load version version              'xrdcp -f -s $src $url/$base/v/f$w'
load version other_versions       'eos file versions $base/v/f$w'
load version other_purge          'eos file purge $base/v/f$w 1'

# Clone a directory, overwrite and rm its file, then clean up the clone. Two
# clones in one second fail: the clone id is the time.
load clone   race_clone           'eos mkdir $own && xrdcp -s $src $url/$own/f && sleep 1 && id=$(eos oldfind -x sys.clone=+10 $own | head -1 | cut -d" " -f2 | cut -d: -f2) && xrdcp -f -s $src $url/$own/f && xrdfs $url rm $own/f; [ -z "$id" ] || eos oldfind -x sys.clone=-$id $own >/dev/null; eos rm -r -F $own'

load admin   write                'xrdcp -f -s $src $url/$own'
load admin   touch                'eos file touch $own.t'
load admin   register             'eos register $own.n size=0'
load admin   symlink              'eos file symlink $own.l $own'
load admin   utimes               'xrdfs $url query opaquefile "$own?mgm.pcmd=utimes&tv1_sec=$i&tv1_nsec=0&tv2_sec=$i&tv2_nsec=0"'
load admin   checksum             'xrdfs $url query checksum $own'
load admin   verify               'eos file verify $own -checksum -commitchecksum -commitsize'
load admin   layout               'eos file layout $own -stripes 1'
load admin   adjustreplica        'eos file adjustreplica $own'
load admin   layout               'eos file layout $own -stripes 2'
load admin   other_convert        'eos convert file $own replica:2'
load admin   file_rename          'eos file rename $own $own.r'
load admin   rm                   'eos rm -F $own.l'
load admin   rm                   'eos rm -F $own.r'
load admin   rm                   'eos rm -F $own.t'
load admin   rm                   'eos rm -F $own.n'

load tree    mkdir                'eos mkdir -p $own/a/b'
load tree    write                'for x in f a/f a/b/f; do xrdcp -s $src $url/$own/$x || exit; done'
load tree    chmod_r              'eos chmod -r 777 $own'
load tree    chown_r              'eos chown -r adm:adm $own'
load tree    attr_r               'eos attr -r set user.tree=$i $own'
load tree    attr_link            'eos attr link $next $own'
load tree    find_tree            'eos find $own'
load tree    rm_r                 'eos rm -r -F $own'

# A tree goes to the recycle bin, comes back, goes again and is purged
load recycle mkdir                'eos mkdir -p $base/r/$w.$i/a'
load recycle write                'xrdcp -s $src $url/$base/r/$w.$i/a/f'
load recycle rm_recycle           'eos rm -r $base/r/$w.$i'
load recycle recycle_restore      'recycle "restore -f" $base/r/$w.$i'
load recycle rm_recycle           'eos rm -r $base/r/$w.$i'
load recycle recycle_purge        'recycle "purge -k" $base/r/$w.$i'

load grpc    grpc_mkdir           '$grpc -p $own mkdir'
load grpc    grpc_touch           '$grpc -p $own/f touch'
load grpc    grpc_xattr           '$grpc --xattr user.grpc=$i -p $own/f setxattr'
load grpc    grpc_chmod           '$grpc --mode 644 -p $own/f chmod'
# The MGM refuses this chown (EPERM), but looks up the file first
load grpc    other_grpc_chown     '$grpc --owner-uid 3 --owner-gid 4 -p $own/f chown'
load grpc    grpc_acl             '$grpc --acl u:3=rwx -p $own acl'
load grpc    grpc_rename          '$grpc --target $own/f2 -p $own/f rename'
load grpc    grpc_symlink         '$grpc --target $own/f2 -p $own/l symlink'
load grpc    grpc_version         '$grpc --max-version 2 -p $own/f2 create-version'
load grpc    grpc_version         '$grpc -p $own/f2 list-version'
load grpc    grpc_version         '$grpc --max-version 1 -p $own/f2 purge-version'
load grpc    grpc_md              'eos-grpc-md --endpoint $grpc_ep -l $own'
load grpc    grpc_md_big          'eos-grpc-md --endpoint $grpc_ep -l $base/big'
load grpc    grpc_find            'eos-grpc-find --endpoint $grpc_ep $d'
load grpc    grpc_rm              '$grpc -p $own/l rm'
# The gRPC rmdir has no recursive mode (-r is not sent): it fails on a
# directory that is not empty
load grpc    other_grpc_rmdir     '$grpc -p $own rmdir'
load grpc    rm_r                 'eos rm -r -F $own'

# All hot workers change one file and its directory at once. The file can
# be renamed away or dropped meanwhile, so all operations are races. The
# writes create the file again.
load hot     race_hot_write       'xrdcp -f -s $src $url/$hot'
load hot     race_hot_append      'xrdcpappend $url/$hot'
load hot     race_hot_read        'xrdcp -f -s $url/$hot /dev/null'
load hot     race_hot_pgread      'xrdcppgread $url/$hot 0 1024'
load hot     race_hot_attr        'eos attr set user.hot=$i $hot'
load hot     race_hot_chmod       'eos chmod 640 $hot'
load hot     race_hot_utimes      'xrdfs $url query opaquefile "$hot?mgm.pcmd=utimes&tv1_sec=$i&tv1_nsec=0&tv2_sec=$i&tv2_nsec=0"'
load hot     race_hot_verify      'eos file verify $hot -checksum -commitchecksum -commitsize'
load hot     race_hot_drop        'drop_replica $hot'
load hot     race_hot_adjustreplica 'eos file adjustreplica $hot'
load hot     race_hot_rename      'xrdfs $url mv $hot $hot.$w && xrdfs $url mv $hot.$w $hot'
load hot     race_hot_convert     'eos convert file $hot replica:2'
load hot     race_hot_dir_attr    'eos attr set user.hot=$i $base/hot'
load hot     race_hot_stat        'xrdfs $url stat $hot'
load hot     race_hot_lock        'eos file touch -l $hot 60 && eos file touch -u $hot'

# One directory grows by 16 entries and shrinks again while it is listed. Each
# touch starts a console, so more entries do not end within the 60 s timeout
load bigdir  bigdir_touch         'for k in $(seq 1 16); do eos file touch -n $base/big/$w.$i.$k || exit; done'
load bigdir  bigdir_ls            'eos ls $base/big'
load bigdir  bigdir_fuse_ls       'xrdcp -f -s "$url//proc/user/?mgm.cmd=fuse&mgm.statentries=1&mgm.path=$base/big" /dev/null'
load bigdir  bigdir_rm            'eos rm -F "$base/big/$w.$i.*"'

# Atomic uploads of two versions of one file. Each read must get one of
# them whole.
load atomic  race_atomic_write    'xrdcp -f -s $src "$url/$base/at/a?eos.atomic=1"'
load atomic  race_atomic_read     'xrdcp -f -s $url/$base/at/a $logs/at.$w && { cmp -s $logs/at.$w $src || cmp -s $logs/at.$w $srcb || echo "step $i of worker $w" >> $logs/atomic.bad; }'
load atomic  race_atomic_write    'xrdcp -f -s $srcb "$url/$base/at/a?eos.atomic=1"'
load atomic  race_atomic_read     'xrdcp -f -s $url/$base/at/a $logs/at.$w && { cmp -s $logs/at.$w $src || cmp -s $logs/at.$w $srcb || echo "step $i of worker $w" >> $logs/atomic.bad; }'

# Each append adds 4096 bytes: the sizes that the FSTs commit must add up
load append  write                '[ $i != 0 ] || xrdcp -s $empty $url/$base/ap/a$w'
load append  append               'xrdcpappend $url/$base/ap/a$w && echo $base/ap/a$w >> $logs/appends'

# xrdstress: 8 threads write and read 64 files
load storm   mkdir                'eos mkdir $own'
load storm   race_storm           'xrdstress -d $url/$own/ -o rdwr -j 8 -f 8 -s 4KB -c'
load storm   rm_r                 'eos rm -r -F $own'

# POSIX calls through the eosxd mount. The FUSE server changes the
# namespace under the global write lock only, the others use MD locks.
load mount   mount_mkdir          'mkdir $mown'
load mount   mount_write          'cp $src $mown/f'
load mount   mount_append         'cat $src >> $mown/f'
load mount   mount_read           'cat $mown/f'
load mount   mount_truncate       'truncate -s 100 $mown/f'
load mount   mount_rename         'mv $mown/f $mown/g'
load mount   mount_hardlink       'ln $mown/g $mown/h'
load mount   mount_symlink        'ln -s g $mown/s'
load mount   mount_chmod          'chmod 600 $mown/g'
load mount   mount_xattr          'setfattr -n user.mount -v $i $mown/g'
load mount   mount_ls             'ls -la $mown'
load mount   other_rm_hardlink    'eos rm -F $own/h'
load mount   mount_unlink         'rm -f $mown/s $mown/g $mown/h'
load mount   mount_rmdir          'rmdir $mown'

run_load

# ----------------------------------------------------------------------------
phase "End checks"
category=Check
end_checks
finish
